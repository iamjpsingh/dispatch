{
  "name": "dispatch-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create dispatch",
    "db:init": "wrangler d1 execute dispatch --file=schema.sql",
    "db:local": "wrangler d1 execute dispatch --local --file=schema.sql",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "vitest": "^3.0.0",
    "wrangler": "^3.22.1"
  }
}
