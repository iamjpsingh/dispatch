# ============================================================================
# Dispatch Configuration
# Copy this file to .env and fill in your values
# ============================================================================

# Environment
NODE_ENV=development

# Server
PORT=5500
BASE_URL=http://localhost:5500
FRONTEND_URL=http://localhost:5173

# Session Security (generate with: openssl rand -hex 64)
SESSION_SECRET=your-secure-session-secret-here

# ============================================================================
# Cloudflare Tracking Worker (Optional)
# ============================================================================
# Only needed if you deploy the tracking Worker manually via CLI.
# If you deploy via the app UI (Settings → Tracking → Connect Cloudflare),
# this is configured automatically.
#
# TRACKING_WORKER_URL=https://dispatch-tracker.your-subdomain.workers.dev

# ============================================================================
# Everything else is configured via the app UI:
#
# - OAuth (Google/Microsoft): Platform Settings → System Mailer
# - SMTP/email providers: Settings → Delivery Servers
# - Tracking: Settings → Tracking (Cloudflare connect + deploy)
# - Domains: Settings → Sending Domains
# ============================================================================

# One-way HMAC secret for GDPR suppression-by-hash (32+ random bytes). Server-only.
SUPPRESSION_HASH_SECRET=
